---
// 右下角圆形阅读进度环（借鉴 doc.natfrp.com 的 BackToTop：滚动进度 + 点击回顶）
---

<button type="button" class="progress-ring-btn" id="progress-ring" aria-label="返回顶部" title="回到顶部">
  <svg class="ring" viewBox="0 0 46 46" aria-hidden="true">
    <circle class="track" cx="23" cy="23" r="20" pathLength="100" fill="none" stroke-width="2.5" />
    <circle
      class="bar"
      cx="23"
      cy="23"
      r="20"
      pathLength="100"
      fill="none"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-dasharray="0 100"
    />
  </svg>
  <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M12 19V5m0 0-6 6m6-6 6 6"></path>
  </svg>
</button>

<script>
  const btn = document.getElementById('progress-ring');
  const barEl = btn?.querySelector<SVGCircleElement>('.bar');

  const update = () => {
    if (!btn) return;
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const p = max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0;
    btn.classList.toggle('is-visible', window.scrollY > 100);
    barEl?.setAttribute('stroke-dasharray', `${p.toFixed(1)} 100`);
    btn.setAttribute('aria-label', `返回顶部（已阅读 ${Math.round(p)}%）`);
  };

  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
