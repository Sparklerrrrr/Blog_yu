---
const links = [
  { href: '/', en: 'HOME', zh: '首页' },
  { href: '/posts/', en: 'ARCHIVE', zh: '文章' },
  { href: '/about/', en: 'ABOUT', zh: '关于' },
];
const path = Astro.url.pathname.replace(/\/+$/, '');
---

<header class="site-nav" id="site-nav">
  <a class="brand" href="/">BLOG_YU</a>
  <nav aria-label="主导航">
    {
      links.map((link) => {
        const active =
          path === link.href.replace(/\/+$/, '') ||
          (link.href !== '/' && path.startsWith(link.href));
        return (
          <a href={link.href} aria-current={active ? 'page' : undefined}>
            {link.zh}
          </a>
        );
      })
    }
  </nav>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const onScroll = () => {
    nav?.classList.toggle('is-scrolled', window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
