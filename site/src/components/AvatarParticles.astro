---
// 头像粒子云：「关于」面板背景层
// 质感复刻 Harness 鲸鱼（柔和圆点/明暗沙粒/加色发光）
// 打散与收拢复刻 AK world（每颗粒子弹簧-阻尼物理：扫过迸散、离开弹性回弹归位）
// 入场：散开 → 一次聚合，之后保持成形
---

<div class="avatar-particles" aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  import * as THREE from 'three';

  (() => {
    const wrap = document.querySelector('.avatar-particles');
    if (!wrap) return;
    const canvas = wrap.querySelector('canvas');
    if (!canvas) return;
    const host = wrap.parentElement || wrap;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const isDark = () => {
      const t = document.documentElement.getAttribute('data-theme');
      if (t === 'dark') return true;
      if (t === 'light') return false;
      const s = document.documentElement.getAttribute('data-skin');
      return s === 'ark' || s === 'hg' || s === 'cc';
    };

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: false,
      powerPreference: 'low-power',
    });
    renderer.setClearColor(0x000000, 0);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 20);
    camera.position.z = 3;
    const halfView = Math.tan(((45 * Math.PI) / 180) / 2) * 3;

    const group = new THREE.Group();
    scene.add(group);

    // ---------- 着色器（鼠标物理移到 CPU 弹簧模拟） ----------
    const VERT = /* glsl */ `
      attribute float aSeed;
      attribute float aBase;
      uniform float uTime;
      uniform float uSize;
      uniform float uScatter; // 入场：1=散开 → 0=聚合
      uniform float uSwirl;
      varying float vSeed;
      varying float vBase;

      vec3 mod289(vec3 x){return x - floor(x * (1.0 / 289.0)) * 289.0;}
      vec4 mod289(vec4 x){return x - floor(x * (1.0 / 289.0)) * 289.0;}
      vec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}
      vec4 taylorInvSqrt(vec4 r){return 1.79284291400159 - 0.85373472095314 * r;}
      float snoise(vec3 v){
        const vec2 C = vec2(1.0/6.0, 1.0/3.0);
        const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
        vec3 i = floor(v + dot(v, C.yyy));
        vec3 x0 = v - i + dot(i, C.xxx);
        vec3 g = step(x0.yzx, x0.xyz);
        vec3 l = 1.0 - g;
        vec3 i1 = min(g.xyz, l.zxy);
        vec3 i2 = max(g.xyz, l.zxy);
        vec3 x1 = x0 - i1 + C.xxx;
        vec3 x2 = x0 - i2 + C.yyy;
        vec3 x3 = x0 - D.yyy;
        i = mod289(i);
        vec4 p = permute(permute(permute(
          i.z + vec4(0.0, i1.z, i2.z, 1.0))
          + i.y + vec4(0.0, i1.y, i2.y, 1.0))
          + i.x + vec4(0.0, i1.x, i2.x, 1.0));
        float n_ = 0.142857142857;
        vec3 ns = n_ * D.wyz - D.xzx;
        vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
        vec4 x_ = floor(j * ns.z);
        vec4 y_ = floor(j - 7.0 * x_);
        vec4 x = x_ * ns.x + ns.yyyy;
        vec4 y = y_ * ns.x + ns.yyyy;
        vec4 h = 1.0 - abs(x) - abs(y);
        vec4 b0 = vec4(x.xy, y.xy);
        vec4 b1 = vec4(x.zw, y.zw);
        vec4 s0 = floor(b0) * 2.0 + 1.0;
        vec4 s1 = floor(b1) * 2.0 + 1.0;
        vec4 sh = -step(h, vec4(0.0));
        vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
        vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;
        vec3 p0 = vec3(a0.xy, h.x);
        vec3 p1 = vec3(a0.zw, h.y);
        vec3 p2 = vec3(a1.xy, h.z);
        vec3 p3 = vec3(a1.zw, h.w);
        vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2,p2), dot(p3,p3)));
        p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
        vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
        m = m * m;
        return 42.0 * dot(m*m, vec4(dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3)));
      }

      void main() {
        vec3 p = position;
        float t = uTime * 0.35;

        // 沙粒漂移：聚合后轻微闪烁
        float drift = 0.024 + uScatter * 0.12;
        p.x += snoise(vec3(position.xy * 1.7 + vec2(0.0, 3.1), t + aSeed * 31.0)) * drift;
        p.y += snoise(vec3(position.xy * 1.7 + vec2(7.7, 2.2), t + aSeed * 31.0)) * drift;

        // 入场：绕中心旋开 → 聚合
        float r0 = length(position.xy);
        float ang = atan(position.y, position.x);
        ang += uScatter * (uSwirl * 1.5 * (0.35 + aSeed * 0.95) + uTime * 0.06 * (0.4 + aSeed));
        float r1 = r0 + uScatter * (0.32 + aSeed * 0.55);
        vec2 scat = vec2(cos(ang), sin(ang)) * r1;
        p.xy = mix(p.xy, scat, uScatter);
        p.z = mix(p.z, p.z * 0.35, uScatter * 0.6);

        vec4 mv = modelViewMatrix * vec4(p, 1.0);
        gl_Position = projectionMatrix * mv;
        gl_PointSize = uSize * (0.7 + aSeed * 1.6) * (160.0 / -mv.z);
        vSeed = aSeed;
        vBase = aBase;
      }
    `;

    const FRAG = /* glsl */ `
      precision highp float;
      varying float vSeed;
      varying float vBase;
      uniform vec3 uColorBright;
      uniform vec3 uColorDeep;
      uniform float uShadeMin;
      uniform float uShadeMax;
      uniform float uOpacity;
      void main() {
        vec2 uv = gl_PointCoord - 0.5;
        float d = length(uv);
        if (d > 0.5) discard;
        float core = smoothstep(0.5, 0.015, d);
        float halo = smoothstep(0.5, 0.1, d) * 0.22;
        float shade = mix(uShadeMin, uShadeMax, vBase);
        vec3 col = mix(uColorDeep, uColorBright, clamp(vBase * 0.8 + vSeed * 0.2, 0.0, 1.0));
        float a = (core + halo) * shade * uOpacity;
        if (a < 0.004) discard;
        gl_FragColor = vec4(col, a);
      }
    `;

    const uniforms = {
      uTime: { value: 0 },
      uSize: { value: 0.075 },
      uScatter: { value: 1 },
      uSwirl: { value: 1 },
      uOpacity: { value: 0.85 },
      uColorBright: { value: new THREE.Color('#ffffff') },
      uColorDeep: { value: new THREE.Color('#2e58a4') },
      uShadeMin: { value: 0.22 },
      uShadeMax: { value: 1.05 },
    };

    const material = new THREE.ShaderMaterial({
      uniforms,
      vertexShader: VERT,
      fragmentShader: FRAG,
      transparent: true,
      depthWrite: false,
      depthTest: false,
      blending: THREE.AdditiveBlending,
    });

    const applyTheme = () => {
      if (isDark()) {
        uniforms.uColorBright.value.set('#ffffff');
        uniforms.uColorDeep.value.set('#2e58a4');
        uniforms.uShadeMax.value = 1.05;
      } else {
        uniforms.uColorBright.value.set('#d9edf9');
        uniforms.uColorDeep.value.set('#1d5a88');
        uniforms.uShadeMax.value = 1.0;
      }
    };
    applyTheme();
    new MutationObserver(applyTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'data-skin'],
    });

    // ---------- 从头像采样粒子 ----------
    let geo = null;
    let BASE = new Float32Array(0);
    let POS = new Float32Array(0);
    let SEEDS = new Float32Array(0);
    let VX = new Float32Array(0);
    let VY = new Float32Array(0);
    let DX = new Float32Array(0);
    let DY = new Float32Array(0);

    const img = new Image();
    img.src = '/avatar.png';
    img.addEventListener('load', () => {
      const S = 128;
      const off = document.createElement('canvas');
      off.width = off.height = S;
      const octx = off.getContext('2d');
      octx.drawImage(img, 0, 0, S, S);
      const id = octx.getImageData(0, 0, S, S).data;
      const mask = new Uint8Array(S * S);
      for (let i = 0; i < S * S; i++) {
        const lum = 0.299 * id[i * 4] + 0.587 * id[i * 4 + 1] + 0.114 * id[i * 4 + 2];
        mask[i] = id[i * 4 + 3] > 10 && lum < 190 ? 1 : 0;
      }

      const N = 12000;
      BASE = new Float32Array(N * 3);
      POS = new Float32Array(N * 3);
      SEEDS = new Float32Array(N);
      const BASES = new Float32Array(N);
      VX = new Float32Array(N);
      VY = new Float32Array(N);
      DX = new Float32Array(N);
      DY = new Float32Array(N);
      let placed = 0;
      let guard = 0;
      while (placed < N && guard < N * 80) {
        guard++;
        const ix = (Math.random() * S) | 0;
        const iy = (Math.random() * S) | 0;
        if (!mask[iy * S + ix]) continue;
        const jx = ix + Math.random();
        const jy = iy + Math.random();
        BASE[placed * 3] = POS[placed * 3] = (jx / S) * 2 - 1;
        BASE[placed * 3 + 1] = POS[placed * 3 + 1] = 1 - (jy / S) * 2;
        BASE[placed * 3 + 2] = POS[placed * 3 + 2] = (Math.random() - 0.5) * 0.24;
        SEEDS[placed] = Math.random();
        const light = 0.7 + 0.3 * ((jx / S) * 0.55 + (1 - jy / S) * 0.45);
        BASES[placed] = Math.min(1, (0.1 + Math.pow(Math.random(), 1.4) * 0.9) * light);
        placed++;
      }

      geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(POS, 3));
      geo.setAttribute('aSeed', new THREE.BufferAttribute(SEEDS, 1));
      geo.setAttribute('aBase', new THREE.BufferAttribute(BASES, 1));
      group.add(new THREE.Points(geo, material));

      if (reduced) {
        uniforms.uScatter.value = 0;
        renderer.render(scene, camera);
      }
      start();
    });

    // ---------- 尺寸与定位：右侧与面板右边界对齐 ----------
    let halfW = halfView;
    let baseScale = 0.5;
    const resize = () => {
      const r = wrap.getBoundingClientRect();
      if (!r.width || !r.height) return;
      renderer.setSize(r.width, r.height, false);
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
      halfW = halfView * (r.width / r.height);
      const targetPx = Math.min(560, Math.max(340, r.height * 0.55, r.width * 0.42));
      baseScale = (targetPx / r.height) * halfView;
      group.scale.setScalar(baseScale);
      // 云的右边界贴齐面板右边界
      group.position.x = halfW - baseScale * 0.98;
      group.position.y = -0.16;
    };
    resize();
    window.addEventListener('resize', resize);
    if ('ResizeObserver' in window) {
      new ResizeObserver(resize).observe(wrap);
    }

    // ---------- 鼠标：AK 式打散（弹簧物理在循环里） ----------
    let hover = 0;
    let mouseX = 999;
    let mouseY = 999;
    let mVelX = 0;
    let mVelY = 0;
    let lastWX = null;
    let lastWY = null;
    let lastT = 0;
    const updateMouse = (e) => {
      const rect = host.getBoundingClientRect();
      const mx = (e.clientX - rect.left) / rect.width;
      const my = (e.clientY - rect.top) / rect.height;
      const wx = (mx - 0.5) * 2 * halfW;
      const wy = (0.5 - my) * 2 * halfView;
      const now = performance.now();
      if (lastWX !== null) {
        const dt = Math.max(16, now - lastT) / 1000;
        let vx = (wx - lastWX) / baseScale / dt;
        let vy = (wy - lastWY) / baseScale / dt;
        const vl = Math.hypot(vx, vy);
        const cap = 2.2;
        if (vl > cap) {
          vx *= cap / vl;
          vy *= cap / vl;
        }
        mVelX += (vx * 0.016 - mVelX) * 0.55;
        mVelY += (vy * 0.016 - mVelY) * 0.55;
      }
      lastWX = wx;
      lastWY = wy;
      lastT = now;
      mouseX = (wx - group.position.x) / baseScale;
      mouseY = (wy - group.position.y) / baseScale;
    };
    host.addEventListener('pointerenter', () => {
      hover = 1;
    });
    host.addEventListener('pointermove', updateMouse);
    host.addEventListener('pointerleave', () => {
      hover = 0;
    });
    host.addEventListener('pointerdown', (e) => {
      updateMouse(e);
      force = 2.2;
    });

    // ---------- 可见性暂停 ----------
    const visible = { on: true };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((ents) => {
        visible.on = ents[0].isIntersecting;
      }).observe(wrap);
    }

    // ---------- 弹簧物理参数（AK 式弹性收拢） ----------
    const SPRING = 0.1;
    const DAMP = 0.86;
    const MAXD = 0.24;
    const PUSH = 0.045;
    const SWIRL = 0.014;
    const INERTIA = 0.5;
    const RAD2 = 0.35 * 0.35;
    let force = 0;

    // ---------- 一次性入场：散开 → 聚合 ----------
    const GATHER = 3200;
    const easeOut = (k) => 1 - Math.pow(1 - k, 3);

    let started = false;
    const start = () => {
      if (started || !geo) return;
      started = true;
      const clock = new THREE.Clock();
      let t0 = null;
      renderer.setAnimationLoop(() => {
        if (!visible.on) return;
        const t = clock.getElapsedTime();
        uniforms.uTime.value = t;
        if (!reduced) {
          if (t0 === null) t0 = t;
          const k = Math.min(1, ((t - t0) * 1000) / GATHER);
          uniforms.uScatter.value = 1 - easeOut(k);

          // 鼠标力场平滑 + 惯性衰减
          force += ((hover ? 1 : 0) - force) * 0.2;
          mVelX *= 0.9;
          mVelY *= 0.9;

          // CPU 弹簧物理：打散 + 弹性收拢
          const N = VX.length;
          for (let i = 0; i < N; i++) {
            const bx = BASE[i * 3];
            const by = BASE[i * 3 + 1];
            let vx = VX[i];
            let vy = VY[i];
            let dx = DX[i];
            let dy = DY[i];
            const px = bx + dx;
            const py = by + dy;
            const mdx = px - mouseX;
            const mdy = py - mouseY;
            const d2 = mdx * mdx + mdy * mdy;
            if (d2 < RAD2 && force > 0.001) {
              const d = Math.sqrt(d2) + 1e-4;
              const f = Math.exp(-d2 * 40.0) * force;
              const seed = SEEDS[i];
              vx += (mdx / d) * f * PUSH * (0.6 + seed * 0.8);
              vy += (mdy / d) * f * PUSH * (0.6 + seed * 0.8);
              vx += (-mdy / d) * f * SWIRL * (0.5 + seed);
              vy += (mdx / d) * f * SWIRL * (0.5 + seed);
              vx += mVelX * f * INERTIA;
              vy += mVelY * f * INERTIA;
            }
            // 弹簧回到锚点
            vx += -dx * SPRING;
            vy += -dy * SPRING;
            vx *= DAMP;
            vy *= DAMP;
            dx += vx;
            dy += vy;
            const dd = Math.hypot(dx, dy);
            if (dd > MAXD) {
              dx *= MAXD / dd;
              dy *= MAXD / dd;
            }
            VX[i] = vx;
            VY[i] = vy;
            DX[i] = dx;
            DY[i] = dy;
            POS[i * 3] = bx + dx;
            POS[i * 3 + 1] = by + dy;
          }
          const posAttr = geo.getAttribute('position');
          if (posAttr) posAttr.needsUpdate = true;

          // 呼吸缩放（无倾斜）
          group.scale.setScalar(baseScale * (1 + Math.sin(t * 0.5) * 0.012));
        }
        renderer.render(scene, camera);
      });
    };
  })();
</script>
