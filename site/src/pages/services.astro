---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERVICES } from '../data/services';

const pageDesc = '服务：网站搭建与部署、技术咨询与排障、AI 工具集成。合作方式与说明。';
---

<BaseLayout title="服务" description={pageDesc}>
  <section class="container">
    <div class="panel reveal-x">
      <header class="page-head">
        <p class="micro-label">SERVICES // 服务</p>
        <h1 class="display-title">服务</h1>
        <p class="micro-label" style="margin-top: var(--sp-3);">
          TOTAL // {SERVICES.length} 项 · 合作请到联系页
        </p>
      </header>

      <div class="service-grid" role="list">
        {
          SERVICES.map((s, i) => (
            <article
              class:list={['card', 'service-card', 'reveal', s.url && 'service-card-clickable']}
              role="listitem"
              style={`--reveal-delay:${(i % 3) * 60}ms`}
            >
              <div class="service-head">
                <span class="service-icon" aria-hidden="true">
                  {s.url ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 3 5 13h6l-1 8 8-10h-6z" /></svg>
                  ) : i === 1 ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 20h18M5 20V9l7-5 7 5v11" /><path d="M9.5 20v-6h5v6" /></svg>
                  ) : i === 2 ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3a7 7 0 0 1 7 7v6a3 3 0 0 1-3 3h-1" /><path d="M12 3a7 7 0 0 0-7 7v6a3 3 0 0 0 3 3h1" /><path d="M12 12v3" /><circle cx="12" cy="19" r="1.4" fill="currentColor" stroke="none" /></svg>
                  ) : (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="7" width="16" height="12" rx="2" /><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7" /><path d="M9 13h6m-3-3v6" /></svg>
                  )}
                </span>
                <div>
                  <h2 class="service-name">{s.name}</h2>
                  <p class="service-desc">{s.desc}</p>
                </div>
              </div>

              <ul class="service-features">
                {s.features.map((f) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m5 12.5 4 4 10-10" /></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>

              <div class="service-foot">
                <div class="service-tags">
                  {s.tags.map((t) => (
                    <span class="service-tag">{t}</span>
                  ))}
                </div>
                <p class="service-note">
                  {s.note}
                  {s.url && <span class="service-enter" aria-hidden="true">进入 →</span>}
                </p>
              </div>
              {s.url && (
                <a class="service-card-hit" href={s.url} aria-label={`进入${s.name}`}></a>
              )}
            </article>
          ))
        }
      </div>

      <p class="service-cta">
        有意向？<a class="tag" href="/contact/">联系我 →</a>
        <a class="tag" style="margin-left: var(--sp-3);" href="/guestbook/">留言板 →</a>
      </p>
    </div>
  </section>
</BaseLayout>
