---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { getPosts } from '../lib/site';

const posts = await getPosts();
---

<BaseLayout title="归档">
  <section class="container">
    <div class="panel reveal-x">
      <header class="page-head">
        <p class="micro-label">ARCHIVE // 归档</p>
        <h1 class="display-title">归档</h1>
        <p class="micro-label" style="margin-top: var(--sp-3);">TOTAL // {posts.length}</p>
      </header>

      {
        posts.length === 0 ? (
          <EmptyState />
        ) : (
          <div class="card-grid">
            {posts.map((post, i) => (
              <ArticleCard post={post} delay={i * 50} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
