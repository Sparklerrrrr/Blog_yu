---
import BaseLayout from '../layouts/BaseLayout.astro';
import { countTags, getPosts } from '../lib/site';

const posts = await getPosts();
const tags = countTags(posts);
---

<BaseLayout title="标签">
  <section class="container">
    <div class="panel reveal-x">
      <header class="page-head">
        <p class="micro-label">TAGS // 标签</p>
        <h1 class="display-title">标签</h1>
      </header>
      {
        tags.length === 0 ? (
          <p class="empty-hint" style="margin-top: var(--sp-4);">还没有标签，写文章时在 frontmatter 里加 tags 即可。</p>
        ) : (
          <>
            <p class="empty-hint" style="margin-bottom: var(--sp-4);">共 {tags.length} 个标签，点击进入对应文章归档。</p>
            <div class="tag-cloud">
              {tags.map(([tag, n]) => (
                <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`} title={`${n} 篇文章`}>
                  {tag} <span class="tag-count">{n}</span>
                </a>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>
