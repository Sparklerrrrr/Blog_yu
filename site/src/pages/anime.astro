---
import BaseLayout from '../layouts/BaseLayout.astro';

import { readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { formatDateTime } from '../lib/site';

const VMID = '421381039'; // B 站 UID
// 构建/开发时 cwd 均为项目根目录（site/），用绝对路径保证读写真实缓存文件
const CACHE_FILE = join(process.cwd(), 'src/data/bangumi.json');

interface Bangumi {
  title: string;
  cover: string;
  url: string;
  progress: string;
  badge?: string;
}

const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

/** 封面兜底：1px 冰川蓝占位（cover 为空时用） */
const FALLBACK_COVER =
  'data:image/svg+xml;utf8,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" width="300" height="400"><rect width="300" height="400" fill="#c6ecf5"/><text x="150" y="205" font-size="16" fill="#1f7397" text-anchor="middle" font-family="monospace">NO COVER</text></svg>'
  );

/** 规范封面地址：补协议 / 空值兜底 */
function normalizeCover(cover: unknown): string {
  const raw = String(cover ?? '');
  const url = raw.replace(/^http:\/\//, 'https://').replace(/^\/\//, 'https://');
  return url || FALLBACK_COVER;
}

/** 进度文案：纯数字 → 「看到第 N 话」，其余（如「全12话」）原样显示 */
function formatProgress(raw: string): string {
  if (/^\d+$/.test(raw)) return '看到第 ' + raw + ' 话';
  return raw;
}

async function fetchBangumi(followStatus: number): Promise<Bangumi[]> {
  // 单次快速尝试（8 秒超时），失败立即返回——页面渲染不能卡住
  try {
    const res = await fetch(
      'https://api.bilibili.com/x/space/bangumi/follow/list?type=1&follow_status=' + followStatus + '&pn=1&ps=30&vmid=' + VMID,
      {
        headers: {
          'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/120',
          Referer: `https://space.bilibili.com/${VMID}/bangumi`,
        },
        signal: AbortSignal.timeout(8000),
      }
    );
    const data = await res.json();
    if (data.code !== 0 || !data.data?.list) return [];
    return (data.data.list as Array<Record<string, unknown>>).map((item) => ({
      title: String(item.title ?? ''),
      cover: normalizeCover(item.cover),
      url: String(item.url ?? ''),
      progress: item.new_ep && typeof item.new_ep === 'object'
        ? formatProgress(String((item.new_ep as Record<string, unknown>).index_show ?? ''))
        : '',
      badge: item.badge ? String(item.badge) : undefined,
    }));
  } catch {
    return [];
  }
}

interface BangumiCache {
  watching?: Bangumi[];
  want?: Bangumi[];
  watched?: Bangumi[];
  /** 最近一次成功同步的时间（ISO） */
  updatedAt?: string;
}

// 缓存优先：先读缓存；尝试快速刷新，成功则更新缓存，失败就用缓存兜底
async function loadBangumi() {
  let cached: BangumiCache | null = null;
  try {
    cached = JSON.parse(readFileSync(CACHE_FILE, 'utf-8'));
  } catch { /* 无缓存 */ }

  const writeCache = (result: BangumiCache) => {
    try {
      writeFileSync(CACHE_FILE, JSON.stringify(result, null, 2));
    } catch { /* 忽略 */ }
  };

  const watching = await fetchBangumi(0);
  if (watching.length > 0) {
    // API 正常：继续拉另两组并写缓存
    await sleep(800);
    const want = await fetchBangumi(1);
    await sleep(800);
    const watched = await fetchBangumi(2);
    const result: BangumiCache = { watching, want, watched, updatedAt: new Date().toISOString() };
    writeCache(result);
    return result;
  }

  // 「在看」为空：可能真的没有在看，也可能是接口异常。再试另两组：
  // 若任一组有数据，说明接口正常，按真实（在看为空）结果处理并写缓存。
  await sleep(800);
  const want = await fetchBangumi(1);
  await sleep(800);
  const watched = await fetchBangumi(2);
  if (want.length > 0 || watched.length > 0) {
    const result: BangumiCache = { watching, want, watched, updatedAt: new Date().toISOString() };
    writeCache(result);
    return result;
  }

  // 全部为空：接口不可用，回退缓存（秒开）
  if (cached && (cached.watching?.length || cached.want?.length || cached.watched?.length)) {
    return {
      watching: cached.watching ?? [],
      want: cached.want ?? [],
      watched: cached.watched ?? [],
      updatedAt: cached.updatedAt,
    };
  }
  return { watching: [], want: [], watched: [], updatedAt: undefined };
}

let { watching, want, watched, updatedAt } = await loadBangumi();

const groups = [
  { key: 'watching', label: '在看', en: 'WATCHING', list: watching },
  { key: 'want', label: '想看', en: 'WANT TO WATCH', list: want },
  { key: 'watched', label: '看过', en: 'WATCHED', list: watched },
];

const total = watching.length + want.length + watched.length;
---

<BaseLayout title="追番">
  <section class="container">
    <div class="panel reveal-x">
      <header class="page-head">
        <p class="micro-label">ANIME // 追番</p>
        <h1 class="display-title">追番</h1>
        <p class="micro-label" style="margin-top: var(--sp-3);">
          SYNC FROM BILIBILI // UID {VMID} // 共 {total} 部
        </p>
      </header>

      {
        total === 0 ? (
          <div class="empty-state card">
            <p class="micro-label">SYNC PENDING</p>
            <p class="empty-msg">追番列表暂时为空</p>
            <p class="empty-hint">
              可能原因：① B 站接口临时风控（稍后自动恢复，重新构建即可同步）；② 追番列表未公开（B 站：空间设置 → 隐私设置 → 公开「追番/追剧」）。
            </p>
          </div>
        ) : (
          groups.map((g) =>
            g.list.length > 0 ? (
              <section class="bangumi-group">
                <div class="section-head">
                  <p class="micro-label">{g.en} // {g.label} // {g.list.length} 部</p>
                  <h2 class="title display-title">{g.label}</h2>
                  <div class="rule" aria-hidden="true"></div>
                </div>
                <div class="bangumi-grid">
                  {g.list.map((item) => (
                    <a class="bangumi-card reveal" href={item.url} target="_blank" rel="noopener noreferrer">
                      <div class="bangumi-cover">
                        <img src={item.cover} alt={item.title} loading="lazy" />
                        {item.badge && <span class="bangumi-badge">{item.badge}</span>}
                      </div>
                      <div class="bangumi-meta">
                        <p class="bangumi-title" title={item.title}>{item.title}</p>
                        {item.progress && <p class="bangumi-progress">{item.progress}</p>}
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            ) : null
          )
        )
      }

      <p class="bangumi-note">
        数据来自我的 B 站追番列表（UID {VMID}），构建站点时自动同步；点击卡片前往 B 站观看。
        {updatedAt && (
          <span class="bangumi-sync-time">// 最近同步 {formatDateTime(new Date(updatedAt))}</span>
        )}
      </p>
    </div>
  </section>
</BaseLayout>
