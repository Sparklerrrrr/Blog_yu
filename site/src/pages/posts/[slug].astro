---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import ProgressRing from '../../components/ProgressRing.astro';
import Comments from '../../components/Comments.astro';
import { CATEGORIES, formatDate, getPosts, readingTime, SITE } from '../../lib/site';

interface Props {
  post: CollectionEntry<'posts'>;
}

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const cat = CATEGORIES[post.data.category];
const mins = readingTime(post.body);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="container-narrow" style="padding-block: var(--sp-9);">
    <article class="panel reveal-x" data-category={post.data.category}>
      <header class="post-head reveal">
      <p class="micro-label">
        <a href={`/posts/?cat=${post.data.category}`}>
          {cat.zh} {cat.en}
        </a>
      </p>
      <h1 class="display-title">{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>// {mins} MIN READ</span>
        <span>// BY {SITE.author.toUpperCase()}</span>
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <div class="tags">
        {post.data.tags.map((t) => (
          <Tag text={t} />
        ))}
      </div>
      <a class="back" href="/posts/">← 返回归档</a>
      </footer>
    </article>

    <Comments pageKey={`/posts/${post.id}/`} pageTitle={post.data.title} />
  </div>

  <ProgressRing />
</BaseLayout>
