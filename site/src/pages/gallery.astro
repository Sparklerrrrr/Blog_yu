---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Wallpaper {
  src: string;
  title: string;
}

const images: Wallpaper[] = [
  { src: '/gallery/wallpapers/wp-01.jpg', title: 'Asuka明日香4K动漫高清壁纸' },
  { src: '/gallery/wallpapers/wp-02.jpg', title: 'miku海报报纸墙' },
  { src: '/gallery/wallpapers/wp-03.jpg', title: '初音报纸墙个性4K动漫电脑壁纸' },
  { src: '/gallery/wallpapers/wp-04.jpg', title: '华为Mate Pad Pro篮球星球' },
  { src: '/gallery/wallpapers/wp-05.jpg', title: '华为Mate Pad Pro蓝色星球' },
  { src: '/gallery/wallpapers/wp-06.jpg', title: '厚涂风动漫女孩长发蓝眼睛头饰唯美4K高清壁纸' },
  { src: '/gallery/wallpapers/wp-07.jpg', title: '微信图片_20260627093039_10_18' },
  { src: '/gallery/wallpapers/wp-08.jpg', title: '明日方舟中秋夜晚精美4K动漫壁纸高清' },
  { src: '/gallery/wallpapers/wp-09.jpg', title: '明日方舟凯尔希兽耳白丝袜长腿4K高清动漫壁纸' },
  { src: '/gallery/wallpapers/wp-10.jpg', title: '明日香报纸墙4K动漫高清电脑壁纸' },
  { src: '/gallery/wallpapers/wp-11.jpg', title: '明日香涂鸦老虎4K动漫高清壁纸' },
  { src: '/gallery/wallpapers/wp-12.jpg', title: '明日香简约线条4K' },
  { src: '/gallery/wallpapers/wp-13.jpg', title: '红色眼睛兔子耳动漫美女坐椅子4K' },
  { src: '/gallery/wallpapers/wp-14.jpg', title: '绫波丽' },
  { src: '/gallery/wallpapers/wp-15.jpg', title: '蓝眼睛长卷发动漫女孩夹克4K高清壁纸' },
  { src: '/gallery/wallpapers/wp-16.jpg', title: '雨夜霓虹赛博朋克女孩' }
];
---

<BaseLayout title="相册">
  <section class="container">
    <div class="panel reveal-x">
      <header class="page-head">
        <p class="micro-label">GALLERY // 相册</p>
        <h1 class="display-title">壁纸合集</h1>
        <p class="micro-label" style="margin-top: var(--sp-3);">WALLPAPERS // {images.length} 张</p>
      </header>

      <div class="gallery-grid" id="gallery-grid">
        {
          images.map((img, i) => (
            <figure class="gallery-item reveal" data-src={img.src} data-title={img.title} data-index={i} style={`--reveal-delay:${(i % 4) * 60}ms`}>
              <img src={img.src} alt={img.title} loading="lazy" />
              <figcaption class="gallery-cap">{img.title}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // 灯箱：点击缩略图全屏查看，支持左右切换/关闭/滑动（事件委托，动态创建遮罩）
  const items = () =>
    Array.from(document.querySelectorAll<HTMLElement>('#gallery-grid .gallery-item'));
  let current = 0;

  const lockScroll = (on: boolean) => { document.documentElement.style.overflow = on ? 'hidden' : ''; };

  // 预载相邻两张，切换零等待
  const preloadAt = (i: number) => {
    const list = items();
    if (list.length === 0) return;
    const src = list[(i + list.length) % list.length]?.dataset.src;
    if (src) {
      const im = new Image();
      im.src = src;
    }
  };

  const openLightbox = (index: number) => {
    closeLightbox();
    current = index;
    const list = items();
    const item = list[current];
    if (!item) return;

    const box = document.createElement('div');
    box.className = 'lightbox';
    box.id = 'lightbox';
    box.innerHTML =
      '<button class="lightbox-close" aria-label="关闭">✕</button>' +
      '<button class="lightbox-nav lightbox-prev" aria-label="上一张">‹</button>' +
      '<figure class="lightbox-fig">' +
      '<img src="' + (item.dataset.src ?? '') + '" alt="' + (item.dataset.title ?? '') + '" draggable="false" />' +
      '<figcaption><span class="lightbox-count">' + (current + 1) + ' / ' + list.length + '</span> ' + (item.dataset.title ?? '') + '</figcaption>' +
      '</figure>' +
      '<button class="lightbox-nav lightbox-next" aria-label="下一张">›</button>';
    document.body.appendChild(box);
    lockScroll(true);
    preloadAt(current + 1);
    preloadAt(current - 1);

    // 触摸滑动切换（pointer 事件，横向位移超过阈值即翻页）
    let startX = 0;
    let startY = 0;
    box.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });
    box.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy)) return;
      showAt(current + (dx < 0 ? 1 : -1));
    });
  };

  const closeLightbox = () => {
    const box = document.getElementById('lightbox');
    if (box) {
      box.remove();
      lockScroll(false);
    }
  };

  const showAt = (i: number) => {
    const list = items();
    if (list.length === 0) return;
    current = (i + list.length) % list.length;
    const item = list[current];
    const img = document.querySelector('#lightbox .lightbox-fig img') as HTMLImageElement | null;
    const cap = document.querySelector('#lightbox figcaption');
    const count = document.querySelector('#lightbox .lightbox-count');
    if (img && item) {
      img.src = item.dataset.src ?? '';
      img.alt = item.dataset.title ?? '';
      // 切换淡入动画
      img.classList.remove('is-swap');
      void img.offsetWidth;
      img.classList.add('is-swap');
    }
    if (cap) cap.lastChild!.textContent = ' ' + (item?.dataset.title ?? '');
    if (count) count.textContent = current + 1 + ' / ' + list.length;
    preloadAt(current + 1);
    preloadAt(current - 1);
  };

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const item = t.closest('.gallery-item');
    if (item && !t.closest('#lightbox')) {
      openLightbox(parseInt((item as HTMLElement).dataset.index ?? '0', 10));
      return;
    }
    if (t.closest('.lightbox-close')) {
      closeLightbox();
      return;
    }
    if (t.closest('.lightbox-prev')) {
      showAt(current - 1);
      return;
    }
    if (t.closest('.lightbox-next')) {
      showAt(current + 1);
      return;
    }
    // 点遮罩空白处关闭
    if ((t as HTMLElement).classList?.contains('lightbox')) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (!document.getElementById('lightbox')) return;
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowLeft') showAt(current - 1);
    else if (e.key === 'ArrowRight') showAt(current + 1);
  });
</script>
