<script>
  // 公告：可关闭，记忆在 localStorage
  // 公告关闭仅当前页面会话有效：刷新/重新进入首页时公告重新出现
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.home-notice-close')) {
      const el = document.querySelector<HTMLElement>('.home-notice');
      if (el) el.classList.add('is-closed');
      // 最新文章向右平推滑入（每次关闭都重放；动画结束后清理类，恢复毛玻璃）
      const posts = document.querySelector<HTMLElement>('.home-posts');
      if (posts) {
        posts.classList.remove('push-anim');
        void posts.offsetWidth; // 强制 reflow，重放动画
        posts.classList.add('push-anim');
        posts.addEventListener(
          'animationend',
          () => posts.classList.remove('push-anim'),
          { once: true }
        );
      }
    }
  });
</script>
