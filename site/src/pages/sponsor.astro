---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="打赏">
  <section class="container sponsor-sec">
    <div class="page-orbs" aria-hidden="true">
      <span class="page-orb o1"></span>
      <span class="page-orb o2"></span>
      <span class="page-orb o3"></span>
    </div>
    <div class="panel reveal-x">
      <header class="page-head sponsor-head">
        <p class="micro-label">SPONSOR // 打赏</p>
        <h1 class="display-title">打赏支持</h1>
        <span class="title-line" aria-hidden="true"></span>
        <p class="sponsor-bless">May all the beauty be blessed!</p>
      </header>

      <p class="sponsor-lead">
        如果我的内容对你有帮助，欢迎通过以下方式打赏我，你的支持是我持续创作的动力！
      </p>
      <p class="sponsor-use">
        您的打赏将用于服务器维护、内容创作和功能开发，帮助我持续提供优质内容。
      </p>

      <div class="sponsor-grid">
        <div class="card sponsor-card reveal" style="--reveal-delay:40ms">
          <div class="sponsor-card-head alipay">
            <svg viewBox="64 64 896 896" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M557.2 129a6.68 6.68 0 016.72 6.65V250.2h243.8a6.74 6.74 0 016.65 6.84c.02 23.92-6.05 54.69-19.85 54.69H563.94v81.1h166.18c7.69 0 13.8 6.51 13.25 14.18l-.11 1.51c-.7 90.2-30.63 180.64-79.52 259.65l8.71 3.82c77.3 33.48 162.15 60.85 267.15 64.14a21.08 21.08 0 0120.38 22.07l-.2 3.95c-3.34 59.57-20 132.85-79.85 132.85-8.8 0-17.29-.55-25.48-1.61-78.04-9.25-156.28-57.05-236.32-110.27l-17.33-11.57-13.15-8.83a480.83 480.83 0 01-69.99 57.25 192.8 192.8 0 01-19.57 11.08c-65.51 39.18-142.21 62.6-227.42 62.62-118.2 0-204.92-77.97-206.64-175.9l-.03-2.95.03-1.7c1.66-98.12 84.77-175.18 203-176.72l3.64-.03c102.92 0 186.66 33.54 270.48 73.14l.44.38 1.7-3.47c21.27-44.14 36.44-94.95 42.74-152.06h-324.8a6.64 6.64 0 01-6.63-6.62c-.04-21.86 6-54.91 19.85-54.91h162.1v-81.1H191.92a6.71 6.71 0 01-6.64-6.85c-.01-22.61 6.06-54.68 19.86-54.68h231.4v-64.85l.02-1.99c.9-30.93 23.72-54.36 120.64-54.36M256.9 619c-74.77 0-136.53 39.93-137.88 95.6l-.02 1.26.08 3.24a92.55 92.55 0 001.58 13.64c20.26 96.5 220.16 129.71 364.34-36.59l-8.03-4.72C405.95 650.11 332.94 619 256.9 619"/></svg>
            <p class="sponsor-name">支付宝</p>
          </div>
          <a class="sponsor-qr-link" href="/sponsor/alipay-qr.jpg" target="_blank" rel="noopener" title="点击查看大图，长按可保存">
            <img class="sponsor-qr" src="/sponsor/alipay-qr.jpg" alt="支付宝收款码" loading="lazy" />
          </a>
          <p class="sponsor-tip">使用 支付宝 扫码打赏</p>
          <a class="sponsor-btn alipay" href="https://qr.alipay.com/fkx16146ug4azwk6yo2cm84" data-jump="alipay" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15" /><path d="m13 6 6 6-6 6" /></svg>
            <span>跳转支付宝付款</span>
          </a>
        </div>

        <div class="card sponsor-card reveal" style="--reveal-delay:120ms">
          <div class="sponsor-card-head">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm5.2 11.2-1.6 1.6-1.8 1.8c-.5.5-1.3.5-1.8 0l-3-3c-.5-.5-.5-1.3 0-1.8l1.6-1.6 3 3c.1.1.3.1.4 0l1.4-1.4c.3-.3.8-.3 1.1 0l.7.7c.3.2.3.7 0 1zm-2.5 2.5 1.8-1.8 1.6-1.6-1.4-1.4-3 3-3-3-1.6 1.6 3.4 3.4 1.4 1.4c.3.3.7.3 1.1 0l.7-.7z"/></svg>
            <p class="sponsor-name">微信</p>
          </div>
          <a class="sponsor-qr-link" href="/sponsor/wechat-qr.jpg" target="_blank" rel="noopener" title="点击查看大图，长按可保存">
            <img class="sponsor-qr" src="/sponsor/wechat-qr.jpg" alt="微信收款码" loading="lazy" />
          </a>
          <p class="sponsor-tip">使用 微信 扫码打赏</p>
          <a class="sponsor-btn wechat" href="https://payapp.wechatpay.cn/sjt/qr/xzb_782576cc568404df839359e19965aef6_001" data-action="wechat-pay" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
            <span>复制收款链接 · 跳转付款</span>
          </a>
          <button type="button" class="sponsor-btn wechat ghost" data-jump="wechat">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15" /><path d="m13 6 6 6-6 6" /></svg>
            <span>打开微信扫一扫</span>
          </button>
          <p class="sponsor-hint" data-hint="wechat">
            在微信内打开本页：点击绿色按钮直接跳转付款；在浏览器打开：点击按钮复制收款链接，粘贴到微信任意聊天框（如文件传输助手）发送后点击即可付款
          </p>
        </div>
      </div>

      <p class="sponsor-thanks">
        每一份打赏我都记在心里。感谢你的喜欢与支持 <span class="heart">❤</span>
      </p>
    </div>
  </section>

  <script>
    // 打赏跳转：
    // 支付宝：alipays:// 深链唤起付款页（未安装时回退网页版收款链接）
    // 微信：收款链接在微信内可直接打开付款页；外部浏览器只能复制 #链接 到微信粘贴点击
    const WECHAT_PAY_LINK = '#付款:Sparkler(w1020557056)/收款/001';
    const isWeChatUA = /MicroMessenger/i.test(navigator.userAgent);

    const copyText = async (text) => {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch (err) {
        // 继续走降级方案
      }
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0;';
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, text.length);
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch (err) {
        ok = false;
      }
      document.body.removeChild(ta);
      return ok;
    };

    const wechatHint = document.querySelector('[data-hint="wechat"]');

    const payBtn = document.querySelector('[data-action="wechat-pay"]');
    if (payBtn) {
      const label = payBtn.querySelector('span');
      if (isWeChatUA && label) {
        // 微信内：按钮直接跳转收款链接付款页
        label.textContent = '跳转微信付款';
      }
      payBtn.addEventListener('click', async (e) => {
        if (isWeChatUA) {
          // 微信内置浏览器：跟随 href 直达付款页
          return;
        }
        e.preventDefault();
        const ok = await copyText(WECHAT_PAY_LINK);
        if (wechatHint) {
          if (ok) {
            // 复制成功：画出来的动画对号（圆环勾边 + 对勾描画 + 弹性弹入）
            wechatHint.innerHTML =
              '<svg class="copy-check" viewBox="0 0 24 24" aria-hidden="true">' +
              '<circle class="check-circle" cx="12" cy="12" r="10" />' +
              '<path class="check-path" d="M7.5 12.5l3 3 6-6" />' +
              '</svg> 收款链接已复制！打开微信，粘贴到任意聊天框（如文件传输助手）发送，点击链接即可跳转付款';
          } else {
            wechatHint.textContent =
              '复制失败，请手动复制这段文字：' + WECHAT_PAY_LINK + '，再粘贴到微信聊天框发送并点击';
          }
          wechatHint.classList.add('is-on');
        }
      });
    }

    const jump = (btn) => {
      const kind = btn.dataset.jump;
      if (kind === 'alipay') {
        const url = btn.getAttribute('href');
        const encoded = encodeURIComponent(url);
        const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
        const scheme = (isIOS ? 'alipayqr://' : 'alipays://')
          + 'platformapi/startapp?saId=10000007&clientVersion=3.7.0.0718&qrcode=' + encoded;
        window.location.href = scheme;
        // 未能唤起支付宝（如未安装 App）时，回退到网页版收款链接
        setTimeout(() => {
          if (!document.hidden) window.location.href = url;
        }, 1100);
      } else if (kind === 'wechat') {
        window.location.href = 'weixin://';
        // 未能唤起微信时，展示指引
        setTimeout(() => {
          if (!document.hidden && wechatHint) {
            wechatHint.textContent = '未能打开微信：请点击上方绿色按钮复制收款链接，粘贴到微信聊天框点击付款；或保存收款码图片后在「扫一扫 → 相册」识别';
            wechatHint.classList.add('is-on');
          }
        }, 1100);
      }
    };
    document.querySelectorAll('[data-jump]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        jump(btn);
      });
    });
  </script>
</BaseLayout>
