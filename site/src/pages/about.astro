---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
import AvatarParticles from '../components/AvatarParticles.astro';

const accounts = [
  {
    name: 'GitHub',
    url: 'https://github.com/Sparklerrrrr',
    desc: '代码仓库与开源项目',
    icon: 'github',
  },
  {
    name: 'Gitee',
    url: 'https://gitee.com/yu_sparklerrr',
    desc: '博客源码托管',
    icon: 'gitee',
  },
  {
    name: 'Bilibili',
    url: 'https://space.bilibili.com/421381039',
    desc: '追番列表与视频',
    icon: 'bilibili',
  },
  {
    name: 'QQ',
    url: 'https://wpa.qq.com/msgrd?v=3&uin=1020557056&site=qq&menu=yes',
    desc: '1020557056',
    icon: 'qq',
  },
  {
    name: 'QQ 邮箱',
    url: 'mailto:1020557056@qq.com',
    desc: '1020557056@qq.com',
    icon: 'mail',
  },
];

const tags = ['C', '嵌入式', '电子电路设计', '全栈开发', '明日方舟', '科技', '哲学', '量子', '通信', '计算'];
---

<BaseLayout title="关于我">
  <section class="about container">
    <span class="watermark" style="top: 12%; right: 6%;" aria-hidden="true">YU</span>
    <div class="page-orbs" aria-hidden="true">
      <span class="page-orb o1"></span>
      <span class="page-orb o2"></span>
      <span class="page-orb o3"></span>
    </div>
    <div class="panel reveal-x">
      <AvatarParticles />
      <!-- 身份头 -->
      <header class="about-head">
        <div class="about-avatar-wrap">
          <a class="about-avatar" href="/" aria-label="回到首页">
            <img src="/avatar.png" alt="我的头像" />
          </a>
        </div>
        <div class="about-id">
          <p class="micro-label">ABOUT ME // 关于我</p>
          <h1 class="display-title">Yu</h1>
          <p class="about-sub">桂林电子科技大学 · 信息与通信学院 · 导航工程（本科）</p>
          <p class="about-tagline">
            未来方向：电子 · 量子 · 通信 · 计算 —— {SITE.zh}（{SITE.en}）
          </p>
          <div class="about-links">
            {accounts.slice(0, 3).map((a) => (
              <a class="tag" href={a.url} target="_blank" rel="noopener">{a.name}</a>
            ))}
          </div>
        </div>
      </header>

      <!-- 座右铭 -->
      <figure class="about-motto reveal" style="--reveal-delay:60ms">
        <blockquote>
          致力于实现个人的不断美好以及全人类的幸福生活。
        </blockquote>
        <figcaption>— MOTTO · 座右铭</figcaption>
      </figure>

      <!-- 自我介绍 -->
      <div class="about-bio reveal" style="--reveal-delay:120ms">
        <p class="micro-label">BIO // 自我介绍</p>
        <p>
          你好，我是 <strong>Yu</strong>，桂林电子科技大学信息与通信学院导航工程专业的本科生。
          目前主要学习<strong>嵌入式</strong>与<strong>电子电路设计</strong>，会 C 语言，也算一个全栈开发者——
          从焊电路板到写前端，都喜欢把东西亲手搭出来。
        </p>
        <p>
          未来想投身<strong>电子、量子、通信与计算</strong>的交叉地带。业余时间玩《明日方舟》，
          对科技与哲学都感兴趣。
        </p>
        <p>
          性格上，我<strong>充满好奇心</strong>，想理解这世间万物的原理，觉得世界非常有趣；
          <strong>有理想、有热情</strong>，想用自己的方式做出积极的贡献和影响，让这个世界知道——我曾经存在过；
          <strong>坚定求真</strong>，愿意坚定地寻求和守护这个世界的真理；也<strong>脚踏实地</strong>——
          解释世界不是终点，改造世界才是。
        </p>
      </div>

      <!-- 技能与兴趣 -->
      <div class="about-tags reveal" style="--reveal-delay:180ms">
        <p class="micro-label">STACK & INTERESTS // 技能与兴趣</p>
        <div class="tag-cloud">
          {tags.map((t, i) => (
            <span class="tag" style={`--i:${i}`}>{t}</span>
          ))}
        </div>
      </div>

      <!-- 基本信息 -->
      <div class="about-facts reveal" style="--reveal-delay:240ms">
        <dl class="facts">
          <div class="fact-row">
            <dt>署名 AUTHOR</dt>
            <dd>{SITE.author}</dd>
          </div>
          <div class="fact-row">
            <dt>学校 SCHOOL</dt>
            <dd>桂林电子科技大学 · 信息与通信学院</dd>
          </div>
          <div class="fact-row">
            <dt>专业 MAJOR</dt>
            <dd>导航工程（本科）</dd>
          </div>
          <div class="fact-row">
            <dt>方向 FOCUS</dt>
            <dd>电子 · 量子 · 通信 · 计算</dd>
          </div>
          <div class="fact-row">
            <dt>坐标 COORDS</dt>
            <dd>{SITE.coords}</dd>
          </div>
          <div class="fact-row">
            <dt>许可 LICENSE</dt>
            <dd>文章 CC BY-NC-SA 4.0 · 代码 MIT</dd>
          </div>
        </dl>
      </div>

      <!-- 足迹 -->
      <div class="about-accounts reveal" style="--reveal-delay:300ms">
        <p class="micro-label">FOLLOW // 足迹</p>
        <div class="account-grid">
          {accounts.map((a) => (
            <a class="card account-card" href={a.url} target="_blank" rel="noopener" data-tilt>
              <span class="account-icon">
                {a.icon === 'github' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
                )}
                {a.icon === 'gitee' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="5" r="2.6" /><circle cx="18" cy="5" r="2.6" /><circle cx="6" cy="19" r="2.6" /><path d="M6 7.6v8.8M18 7.6a7 7 0 0 0-8 12" /></svg>
                )}
                {a.icon === 'bilibili' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="8" width="17" height="11" rx="1.5" /><path d="M8 8l4-3.5L16 8" /><path d="M9 12.5v3M12 11v6M15.5 12.5v3" /></svg>
                )}
                {a.icon === 'qq' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.395 15.035a39.548 39.548 0 0 0-.803-2.264l-1.079-2.695c.001-.032.014-.562.014-.836C19.526 4.632 17.351 0 12 0S4.474 4.632 4.474 9.241c0 .274.013.804.014.836l-1.08 2.695a38.97 38.97 0 0 0-.802 2.264c-1.021 3.283-.69 4.643-.438 4.673.54.065 2.103-2.472 2.103-2.472 0 1.098.474 3.122 1.519 4.178a2.93 2.93 0 0 0-.471 1.571c0 1.544 1.306 2.013 2.98 2.013 1.673 0 2.98-.469 2.98-2.013 0-.604-.238-1.158-.567-1.625.996-.993 1.56-2.938 1.56-4.124 0 0 1.561 2.537 2.102 2.472.251-.03.582-1.39-.439-4.673zM12 1.885c2.815 0 4.668 2.223 4.668 4.982 0 .082-.002.163-.005.244-2.006-.972-4.413-1.544-4.663-1.544s-2.657.572-4.663 1.544a5.1 5.1 0 0 1-.005-.244c0-2.759 1.853-4.982 4.668-4.982z"/></svg>
                )}
                {a.icon === 'mail' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 20q-.825 0-1.412-.587T2 18V6q0-.825.588-1.412T4 4h16q.825 0 1.413.588T22 6v12q0 .825-.587 1.413T20 20zm8-7L4 8v10h16V8zm0-2 8-5H4zm-8-3v2.075L12 14l8-4.925V8zm8 6z"/></svg>
                )}
              </span>
              <span class="account-meta">
                <span class="account-name">{a.name}</span>
                <span class="account-desc">{a.desc}</span>
              </span>
              <svg class="ext-icon" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true"><path d="M384 64c-17.7 0-32 14.3-32 32s14.3 32 32 32h82.7L265.3 329.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L512 173.3V256c0 17.7 14.3 32 32 32s32-14.3 32-32V96c0-17.7-14.3-32-32-32zm-240 96c-44.2 0-80 35.8-80 80v256c0 44.2 35.8 80 80 80h256c44.2 0 80-35.8 80-80v-80c0-17.7-14.3-32-32-32s-32 14.3-32 32v80c0 8.8-7.2 16-16 16H144c-8.8 0-16-7.2-16-16V240c0-8.8 7.2-16 16-16h80c17.7 0 32-14.3 32-32s-14.3-32-32-32z"/></svg>
            </a>
          ))}
        </div>
      </div>

      <p style="margin-top: var(--sp-6);">
        <a class="tag" href="/posts/">浏览全部文章 →</a>
        <a class="tag" style="margin-left: var(--sp-3);" href="/sponsor/">打赏支持 →</a>
        <a class="tag" style="margin-left: var(--sp-3);" href="/guestbook/">留言板 →</a>
      </p>
    </div>
  </section>
</BaseLayout>
