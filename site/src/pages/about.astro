---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
---

<BaseLayout title="关于">
  <section class="about container">
    <span class="watermark" style="top: 12%; right: 6%;" aria-hidden="true">YU</span>
    <div class="panel">
      <p class="micro-label">ABOUT // 关于</p>
      <h1 class="display-title">ABOUT</h1>
      <p class="lede reveal">
        这里是{SITE.zh}（{SITE.en}），{SITE.author} 的个人博客。记录技术、生活与思考——
        像明日方舟的界面一样：克制、有序、留白。
      </p>
      <dl class="facts reveal" style="--reveal-delay:120ms">
        <dt>站名 NAME</dt>
        <dd>{SITE.zh} / {SITE.en}</dd>
        <dt>署名 AUTHOR</dt>
        <dd>{SITE.author}</dd>
        <dt>定位 FOCUS</dt>
        <dd>记录 · 思考 · 建造</dd>
        <dt>坐标 COORDS</dt>
        <dd>{SITE.coords}</dd>
      </dl>
      <p style="margin-top: var(--sp-6);">
        <a class="tag" href="/posts/">浏览全部文章 →</a>
      </p>
    </div>
  </section>
</BaseLayout>
