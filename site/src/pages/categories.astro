---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, getPosts } from '../lib/site';

const posts = await getPosts();
const counts: Record<string, number> = {};
for (const p of posts) {
  counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;
}
const cats = Object.entries(CATEGORIES);
---

<BaseLayout title="分类">
  <section class="container">
    <div class="panel reveal-x">
      <header class="page-head">
        <p class="micro-label">CATEGORIES // 分类</p>
        <h1 class="display-title">分类</h1>
      </header>
      <div class="cat-grid">
        {cats.map(([id, cat], i) => (
          <a
            class="card cat-block reveal"
            href={`/posts/?cat=${id}`}
            data-category={id}
            data-tilt
            style={`--reveal-delay:${i * 80}ms`}
          >
            <p class="micro-label">{cat.en}</p>
            <p class="cat-name">{cat.zh}</p>
            <span class="cat-num" aria-hidden="true">{String(counts[id] ?? 0).padStart(2, '0')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
