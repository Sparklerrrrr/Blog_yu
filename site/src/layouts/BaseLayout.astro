---
import { ClientRouter } from 'astro:transitions';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import '../styles/tokens.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/pages.css';
import '../styles/read-hud.css';

interface Props {
  title?: string;
  description?: string;
  /** OpenGraph 类型：website（默认）/ article（文章页） */
  ogType?: 'website' | 'article';
  /** 文章发布时间（article 类型时输出 article:published_time） */
  publishedTime?: Date;
  /** 文章最后更新时间（可选） */
  modifiedTime?: Date;
  /** OpenGraph 图片路径（可选，如 /avatar.png） */
  image?: string;
  /** 页面级 body class（归档三维终端等全屏页面用） */
  bodyClass?: string;
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  image,
  bodyClass,
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE.tabTitle}` : `${SITE.tabTitle} | ${SITE.en}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = image ? new URL(image, canonical).href : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={`${SITE.zh} · ${SITE.en}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script is:inline>
      // 主题防闪烁：尽早恢复明暗偏好（浅色冰川 / 暗色冰川）
      // ClientRouter 换页后会重建 <html> 属性，需在 after-swap 重新补上。
      (() => {
        const apply = () => {
          document.documentElement.classList.add('js');
          try {
            document.documentElement.dataset.theme = localStorage.getItem('blog-theme') || 'light';
          } catch (e) {
            document.documentElement.dataset.theme = 'light';
          }
          // READ FULL TEXT：HUD 扩张的 root 裁切参数（首次加载与 ClientRouter 换页都要补）
          try {
            if (sessionStorage.getItem('blogyu:read-nav') === '1') {
              sessionStorage.removeItem('blogyu:read-nav');
              const clip = sessionStorage.getItem('blogyu:read-clip');
              const expand = sessionStorage.getItem('blogyu:read-expand');
              sessionStorage.removeItem('blogyu:read-clip');
              sessionStorage.removeItem('blogyu:read-expand');
              document.documentElement.classList.add('read-nav');
              if (clip) document.documentElement.style.setProperty('--read-clip-from', clip);
              if (expand) document.documentElement.style.setProperty('--read-expand', `${expand}ms`);
            }
          } catch (e) {}
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body class={bodyClass || undefined}>
    <div id="progress-bar" aria-hidden="true"></div>
    <div class="top-glow" aria-hidden="true"></div>
    <TopNav />
    <div id="read-hud" class="read-hud" aria-hidden="true" transition:persist>
      <svg class="read-hud__trace" aria-hidden="true"><rect /></svg>
      <i class="read-hud__edge h"></i>
      <i class="read-hud__edge h"></i>
      <i class="read-hud__edge v"></i>
      <i class="read-hud__edge v"></i>
      <i class="read-hud__c c0"></i>
      <i class="read-hud__c c1"></i>
      <i class="read-hud__c c2"></i>
      <i class="read-hud__c c3"></i>
      <span class="read-hud__label"></span>
    </div>
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Toast 轻提示容器（复制 / 操作反馈） -->
    <div id="toast-host" class="toast-host" role="status" aria-live="polite" transition:persist></div>

    <script src="../scripts/app.ts"></script>
  </body>
</html>
